<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Allow running on newer .NET runtimes when net10.0 isn't installed. -->
    <RollForward>Major</RollForward>
    <RootNamespace>imlac</RootNamespace>
    <AssemblyName>sImlac</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDL2 bindings; bundles native SDL2 for win-x64/x86, linux-x64 and macOS.
         On other platforms (e.g. linux-arm64) the system libSDL2 is used. -->
    <PackageReference Include="ppy.SDL2-CS" Version="1.0.82" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="boot\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="notes\readme.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="notes\software.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
